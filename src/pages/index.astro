---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CorruptedBitsAI - AI Character Commissions</title>
    <meta name="description" content="AI-assisted character artwork commissions using Koikatsu and Krita. Supporting my journey through university." />
    
    <!-- Bulma CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
    
    <!-- Ko-fi Widget -->
    <script src='https://storage.ko-fi.com/cdn/scripts/overlay-widget.js'></script>
</head>
<body class="has-background">
    <!-- Navigation -->
    <nav class="navbar is-transparent is-spaced">
        <div class="navbar-brand">
            <div class="navbar-item">
                <p class="title is-4">✨ CorruptedBitsAI</p>
            </div>
        </div>
        <div class="navbar-menu">
            <div class="navbar-end">
                <div class="navbar-item">
                    <div class="buttons">
                        <a class="button is-light" href="#portfolio">Portfolio</a>
                        <a class="button is-info" href="#support">Support Me</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main>
        <!-- Hero Section -->
        <section class="section hero-gradient">
            <div class="container">
                <div class="content has-text-centered">
                    <h1 class="title is-1 is-spaced">✨ Welcome! ✨</h1>
                    <p class="subtitle is-3 mb-5">
                        AI-Assisted Character Commissions<br />
                        <span class="is-size-5">Helping pay for my university journey 💕</span>
                    </p>
                    <div class="content mb-6">
                        <p class="is-size-5" style="line-height: 1.6;">
                            I create high-quality character artwork using <strong>Koikatsu</strong> bases and <strong>Krita</strong> for AI-assisted enhancement.<br />
                            With 2.5+ years of AI image creation experience, I'm now offering commissions to support my education.
                        </p>
                    </div>
                    <a class="button is-large is-warning has-text-dark" id="support-btn">
                        💰 Commission Me / Support
                    </a>
                </div>
            </div>
        </section>

        <!-- Divider with polka dots -->
        <div class="polka-divider"></div>

        <!-- Portfolio Section -->
        <section class="section" id="portfolio">
            <div class="container">
                <h2 class="title is-2 has-text-centered mb-6">📸 What I Create</h2>
                
                <div class="columns is-multiline">
                    <div class="column is-4-desktop is-6-tablet">
                        <div class="box has-background-light portfolio-item">
                            <div class="portfolio-placeholder gradient-1"></div>
                            <h3 class="title is-5 mt-5">Character Designs</h3>
                            <p>Beautiful, detailed character artwork with custom requests and specifications.</p>
                        </div>
                    </div>
                    
                    <div class="column is-4-desktop is-6-tablet">
                        <div class="box has-background-light portfolio-item">
                            <div class="portfolio-placeholder gradient-2"></div>
                            <h3 class="title is-5 mt-5">Custom Commissions</h3>
                            <p>Bring your OCs to life with AI-assisted enhancement and professional finishing.</p>
                        </div>
                    </div>
                    
                    <div class="column is-4-desktop is-6-tablet">
                        <div class="box has-background-light portfolio-item">
                            <div class="portfolio-placeholder gradient-3"></div>
                            <h3 class="title is-5 mt-5">Quality Assured</h3>
                            <p>High-resolution outputs with professional color correction and detail work.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Why Support Section -->
        <section class="section support-section">
            <div class="container">
                <div class="box content-box">
                    <h2 class="title is-2 mb-5">❤️ Why Your Support Matters</h2>
                    <p class="is-size-5 mb-4">
                        <strong>I'm a university student</strong> working to cover:
                    </p>
                    <ul class="is-size-5" style="margin-left: 2rem;">
                        <li>📚 Textbooks & course materials</li>
                        <li>🔬 Lab supplies & equipment</li>
                        <li>🎓 Tuition fees</li>
                    </ul>
                    <p class="is-size-5 mt-5">
                        Your commissions directly support my education and allow me to create better, more detailed artwork for you!
                    </p>
                </div>
            </div>
        </section>

        <!-- Social & Support Section -->
        <section class="section social-section" id="support">
            <div class="container">
                <h2 class="title is-2 has-text-centered mb-6">🤝 Connect & Support</h2>
                
                <div class="columns is-centered">
                    <div class="column is-8-desktop">
                        <div class="box has-background-gradient-soft">
                            <div class="buttons is-centered is-multiline">
                                <a href="https://x.com/CorruptedBitsAI" target="_blank" class="button is-info is-light is-large">
                                    𝕏 Twitter
                                </a>
                                <a href="https://www.instagram.com/corruptedbitsai/" target="_blank" class="button is-danger is-light is-large">
                                    📷 Instagram
                                </a>
                                <a href="https://www.tiktok.com/@corruptedbitsai" target="_blank" class="button is-dark is-light is-large">
                                    🎵 TikTok
                                </a>
                                <a href="https://ko-fi.com/corruptedbitsai" target="_blank" class="button is-warning is-large">
                                    ☕ Ko-Fi / Donate
                                </a>
                            </div>
                            <p class="has-text-centered mt-6 is-size-5">
                                <strong>Questions? Just DM me!</strong> I'm happy to discuss ideas, pricing, and any custom requests.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Polka dot footer divider -->
        <div class="polka-divider"></div>

        <!-- Footer -->
        <footer class="footer has-background-light">
            <div class="content has-text-centered">
                <p>
                    <strong>CorruptedBitsAI</strong> © 2025 | AI-Assisted Character Commissions
                </p>
                <p class="is-size-7">
                    Supporting my university journey, one commission at a time 💕
                </p>
            </div>
        </footer>
    </main>

    <script>
        // Ko-Fi Widget
        kofiWidgetOverlay.draw('corruptedbitsai', {
            'type': 'floating-chat',
            'floating-chat.donateButton.text': 'Support Me',
            'floating-chat.donateButton.background-color': '#fcbf47',
            'floating-chat.donateButton.text-color': '#323842'
        });

        // Support button handler
        document.getElementById('support-btn').addEventListener('click', () => {
            window.location.href = '#support';
        });
    </script>
</body>
</html>
